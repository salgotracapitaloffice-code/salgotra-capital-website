---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  texture?: 'ear' | 'none';
}
const { eyebrow, title, intro, texture = 'none' } = Astro.props;
---

<section class="page-head bg-midnight" aria-labelledby="page-title">
  {texture === 'ear' && <div class="page-head__ear" aria-hidden="true" />}
  <div class="container">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1 id="page-title">{title}</h1>
    {intro && <p class="lede">{intro}</p>}
    <slot />
  </div>
</section>

<style>
  /* About page only: a heavily faded detail of the elephant's ear */
  .page-head__ear {
    position: absolute;
    inset: 0 0 0 auto;
    width: min(60%, 44rem);
    background: url('/images/ear-texture.webp') center 35% / cover no-repeat;
    opacity: 0.08;
    mix-blend-mode: screen;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 55%);
    mask-image: linear-gradient(90deg, transparent 0%, #000 55%);
    pointer-events: none;
  }
  .container {
    position: relative;
  }
</style>
