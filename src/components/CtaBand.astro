---
// Closing call to action used at the end of every page except Contact, Privacy and 404.
// The line itself is the section's heading, so there is no hidden heading to leave a gap.
interface Props {
  line: string;
}
const { line } = Astro.props;
---

<section class="section bg-midnight cta-band" aria-labelledby="cta-line">
  <div class="container reveal">
    <h2 id="cta-line" class="cta-band__line">{line}</h2>
    <a class="button" href="/contact/">Start a confidential conversation</a>
  </div>
</section>

<style>
  .cta-band {
    text-align: center;
    border-top: 1px solid color-mix(in srgb, var(--champagne) 30%, transparent);
  }
  .cta-band__line {
    margin-inline: auto;
    max-width: 34rem;
    font-size: clamp(1.6rem, 1.3rem + 1.2vw, 2.2rem);
    line-height: 1.3;
    color: var(--ivory);
  }
  .button {
    margin-top: 2.25rem;
  }
</style>
