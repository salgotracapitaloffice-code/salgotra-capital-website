---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { SITE } from '../../site.config.mjs';

const phone = SITE.PHONE.trim();
const phoneHref = phone.replace(/[^\d+]/g, '');
const isNetlify = SITE.form.provider === 'netlify';
const thanks = 'Thank you. One of our directors will contact you personally within two working days.';
const failure = `Sorry, that did not send. Please email us at ${SITE.contactEmail}.`;
---

<Base
  title="Start a confidential conversation | Salgotra Capital"
  description="Whether you are ready now or simply thinking ahead, we would be glad to hear from you. Everything you share stays private."
>
  <PageHead
    eyebrow="Contact"
    title="Start a confidential conversation."
  >
    <p class="lede">
      Whether you are ready now or simply thinking ahead, we would be glad to hear from you. Everything you share
      stays private, as set out in our <a href="/privacy/">privacy policy</a>.
    </p>
  </PageHead>

  <section class="section on-light grain grain--both contact" aria-label="Contact form and details">
    <div class="container contact__grid">
      <div class="contact__form-wrap">
        <form
          class="enquiry"
          name={SITE.form.name}
          method="POST"
          action={isNetlify ? '/contact/sent/' : SITE.form.endpoint}
          data-endpoint={isNetlify ? '/' : SITE.form.endpoint}
          data-provider={SITE.form.provider}
          data-netlify={isNetlify ? 'true' : undefined}
          netlify-honeypot={isNetlify ? 'bot-field' : undefined}
          novalidate
        >
          {isNetlify && <input type="hidden" name="form-name" value={SITE.form.name} />}
          <p class="honeypot" aria-hidden="true">
            <label>Leave this field empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </p>

          <div class="field">
            <label for="f-name">Name <span class="req">(required)</span></label>
            <input id="f-name" name="name" type="text" autocomplete="name" required aria-describedby="f-name-err" />
            <p class="field__error" id="f-name-err" data-msg="Please enter your name." hidden></p>
          </div>

          <div class="field-row">
            <div class="field">
              <label for="f-business">Business name</label>
              <input id="f-business" name="business" type="text" autocomplete="organization" />
            </div>
            <div class="field">
              <label for="f-city">City</label>
              <input id="f-city" name="city" type="text" autocomplete="address-level2" />
            </div>
          </div>

          <fieldset class="reach" aria-describedby="f-reach-help">
            <legend class="visually-hidden">How we can reach you: a phone number or an email address</legend>
            <div class="field-row">
              <div class="field">
                <label for="f-phone">Phone</label>
                <input
                  id="f-phone"
                  name="phone"
                  type="tel"
                  autocomplete="tel"
                  inputmode="tel"
                  aria-describedby="f-reach-help f-reach-err"
                />
              </div>
              <div class="field">
                <label for="f-email">Email</label>
                <input
                  id="f-email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  inputmode="email"
                  spellcheck="false"
                  aria-describedby="f-reach-help f-reach-err"
                />
              </div>
            </div>
            <p class="field__help" id="f-reach-help">
              Please give a phone number or an email address, whichever you prefer.
            </p>
            <p
              class="field__error"
              id="f-reach-err"
              data-msg="Please give a phone number or an email address so we can reach you."
              data-msg-invalid="Please check your email address."
              hidden
            >
            </p>
          </fieldset>

          <div class="field">
            <label for="f-message">Tell us a little about your business (optional)</label>
            <textarea id="f-message" name="message" rows="6"></textarea>
          </div>

          <div class="field field--check">
            <input id="f-consent" name="consent" type="checkbox" value="yes" required aria-describedby="f-consent-err" />
            <label for="f-consent">
              I agree that Salgotra Capital may use these details only to respond to my enquiry. (<a href="/privacy/"
                >privacy policy</a
              >)
            </label>
            <p class="field__error" id="f-consent-err" data-msg="Please tick this box so that we can reply to you." hidden>
            </p>
          </div>

          <div class="enquiry__actions">
            <button class="button" type="submit" data-label="Send in confidence">Send in confidence</button>
            <p class="enquiry__note">A director will reply personally within two working days.</p>
          </div>
          <p class="enquiry__failure" role="alert" hidden>{failure}</p>
        </form>

        <div class="enquiry__thanks" tabindex="-1" hidden>
          <hr class="rule" />
          <p>{thanks}</p>
        </div>
      </div>

      <aside class="contact__side">
        <div class="side-block" aria-labelledby="next-title">
          <h2 id="next-title" class="side-label">What happens next</h2>
          <ol class="next" role="list">
            <li>A director reads your message and replies within two working days.</li>
            <li>If it makes sense for both of us, we arrange a call or a meeting at a time and place that suits you.</li>
            <li>Nothing is shared with anyone, and nothing is committed, at this stage.</li>
          </ol>
        </div>

        <div class="side-block" aria-labelledby="direct-title">
          <h2 id="direct-title" class="side-label">Direct contact</h2>
          <ul class="direct" role="list">
            <li>
              <span class="direct__name">Email</span>
              <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>
            </li>
            {
              phone && (
                <li>
                  <span class="direct__name">Phone</span>
                  <a href={`tel:${phoneHref}`}>{phone}</a>
                </li>
              )
            }
          </ul>
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .contact__grid {
    display: grid;
    gap: 3.5rem clamp(3rem, 7vw, 6rem);
    align-items: start;
  }
  @media (min-width: 60rem) {
    .contact__grid {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    }
  }
  .contact__form-wrap,
  .contact__side {
    background: var(--cream);
    box-shadow: 0 0 2.5rem 1.5rem var(--cream);
  }

  /* ---------- Form ---------- */
  .enquiry {
    display: grid;
    gap: 1.6rem;
    max-width: 40rem;
  }
  .field {
    display: grid;
    gap: 0.45rem;
    min-width: 0;
  }
  .contact__grid > *,
  .field-row > * {
    min-width: 0;
  }
  .field-row {
    display: grid;
    gap: 1.6rem;
  }
  @media (min-width: 36rem) {
    .field-row {
      grid-template-columns: 1fr 1fr;
    }
  }
  label {
    color: var(--ink);
    font-size: 1.125rem;
  }
  .reach {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
    display: grid;
    gap: 0.6rem;
  }
  .field__help {
    color: var(--ink-soft);
    font-size: 1rem;
  }
  .req {
    color: var(--ink-soft);
    font-style: italic;
    font-size: 1rem;
  }
  input[type='text'],
  input[type='email'],
  input[type='tel'],
  textarea {
    width: 100%;
    min-width: 0;
    min-height: 3rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid #8a7f6c; /* 3.2:1 against Cream, for a visible field edge */
    border-radius: 0;
    background: #f3efe6;
    color: var(--ink);
    font-size: 1.0625rem; /* at least 16px, so phones do not zoom in */
    line-height: 1.5;
    scroll-margin-block: 6rem 40vh;
    transition:
      border-color var(--fast) var(--ease),
      background-color var(--fast) var(--ease);
  }
  textarea {
    resize: vertical;
    min-height: 9rem;
  }
  input:hover,
  textarea:hover {
    border-color: var(--umber);
  }
  input:focus-visible,
  textarea:focus-visible {
    outline: 2px solid var(--bronze);
    outline-offset: 1px;
    border-color: var(--umber);
    background: #f8f5ee;
  }
  input[aria-invalid='true'],
  textarea[aria-invalid='true'] {
    border-color: var(--burgundy);
  }
  .field__error {
    color: var(--burgundy);
    font-size: 1rem;
  }

  .field--check {
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 0.4rem 0.9rem;
  }
  .field--check input {
    appearance: none;
    width: 1.5rem;
    height: 1.5rem;
    margin-top: 0.2rem;
    border: 1px solid #8a7f6c;
    background: #f3efe6;
    display: grid;
    place-items: center;
    cursor: pointer;
    /* enlarge the tap target without enlarging the box */
    box-shadow: 0 0 0 0.6rem transparent;
  }
  .field--check input::after {
    content: '';
    width: 0.45rem;
    height: 0.8rem;
    border: solid var(--ivory);
    border-width: 0 2px 2px 0;
    transform: translateY(-1px) rotate(45deg);
    opacity: 0;
  }
  .field--check input:checked {
    background: var(--midnight);
    border-color: var(--midnight);
  }
  .field--check input:checked::after {
    opacity: 1;
  }
  .field--check input[aria-invalid='true'] {
    border-color: var(--burgundy);
  }
  .field--check label {
    cursor: pointer;
    line-height: 1.5;
    padding-block: 0.1rem;
  }
  .field--check .field__error {
    grid-column: 2;
  }

  .enquiry__actions {
    padding-top: 0.5rem;
  }
  .enquiry__actions .button {
    min-width: min(14rem, 100%);
  }
  .enquiry__note {
    margin-top: 0.85rem;
    font-size: 1rem;
    color: var(--ink-soft);
  }
  .enquiry__failure {
    color: var(--ink);
    border-left: 2px solid var(--burgundy);
    padding: 0.3rem 0 0.3rem 1rem;
  }
  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .enquiry__thanks p {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.3rem + 0.8vw, 1.9rem);
    line-height: 1.35;
    color: var(--ink);
    max-width: 32rem;
  }
  .enquiry__thanks .rule {
    margin-top: 0;
  }
  .enquiry__thanks:focus {
    outline: none;
  }

  /* ---------- What happens next and direct contact ---------- */
  .side-block + .side-block {
    margin-top: 2.75rem;
  }
  .side-label {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.6;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--bronze);
    margin-bottom: 1rem;
  }
  .next {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--bronze);
    counter-reset: next;
  }
  .next li {
    counter-increment: next;
    position: relative;
    padding: 1rem 0 1rem 2.25rem;
    border-bottom: 1px solid color-mix(in srgb, var(--umber) 22%, transparent);
    color: var(--ink);
  }
  .next li::before {
    content: counter(next);
    position: absolute;
    left: 0;
    top: 0.95rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.3rem;
    color: var(--bronze);
  }
  .direct {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--bronze);
  }
  .direct li {
    display: grid;
    padding-block: 1rem;
    border-bottom: 1px solid color-mix(in srgb, var(--umber) 22%, transparent);
  }
  .direct__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.3rem;
    color: var(--ink);
  }
  .direct a {
    display: inline-block;
    padding-block: 0.5rem;
    overflow-wrap: anywhere;
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('form.enquiry');
  if (form) {
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const failure = form.querySelector<HTMLElement>('.enquiry__failure')!;
    const thanks = document.querySelector<HTMLElement>('.enquiry__thanks')!;
    const name = form.querySelector<HTMLInputElement>('#f-name')!;
    const consent = form.querySelector<HTMLInputElement>('#f-consent')!;
    const phoneInput = form.querySelector<HTMLInputElement>('#f-phone')!;
    const emailInput = form.querySelector<HTMLInputElement>('#f-email')!;
    const reachErr = document.getElementById('f-reach-err')!;
    let sending = false;
    let triedSubmit = false;

    // Name and consent: required on their own
    const checkRequired = (input: HTMLInputElement) => {
      const err = document.getElementById(`${input.id}-err`)!;
      const ok = input.type === 'checkbox' ? input.checked : input.value.trim() !== '';
      err.textContent = ok ? '' : err.dataset.msg!;
      err.hidden = ok;
      input.setAttribute('aria-invalid', ok ? 'false' : 'true');
      return ok;
    };

    // Phone or email: at least one, and the email must look like an email if given
    const checkReach = () => {
      const phone = phoneInput.value.trim();
      const email = emailInput.value.trim();
      let msg = '';
      let bad: HTMLInputElement[] = [];
      if (!phone && !email) {
        msg = reachErr.dataset.msg!;
        bad = [phoneInput, emailInput];
      } else if (email && emailInput.validity.typeMismatch) {
        msg = reachErr.dataset.msgInvalid!;
        bad = [emailInput];
      }
      reachErr.textContent = msg;
      reachErr.hidden = !msg;
      [phoneInput, emailInput].forEach((el) => el.setAttribute('aria-invalid', bad.includes(el) ? 'true' : 'false'));
      return bad;
    };

    name.addEventListener('blur', () => triedSubmit && checkRequired(name));
    consent.addEventListener('change', () => consent.getAttribute('aria-invalid') === 'true' && checkRequired(consent));
    [phoneInput, emailInput].forEach((el) =>
      el.addEventListener('input', () => {
        if (!reachErr.hidden) checkReach();
      }),
    );
    emailInput.addEventListener('blur', () => {
      if (emailInput.value.trim()) checkReach();
    });

    // On phones, keep the field being typed in above the on-screen keyboard.
    const vv = window.visualViewport;
    if (vv && matchMedia('(pointer: coarse)').matches) {
      form.addEventListener('focusin', (e) => {
        const el = e.target as HTMLElement;
        if (!el.matches('input:not([type="checkbox"]), textarea')) return;
        setTimeout(() => {
          const r = el.getBoundingClientRect();
          if (r.bottom > vv.height - 16 || r.top < 0) el.scrollIntoView({ block: 'center', behavior: 'smooth' });
        }, 350);
      });
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (sending) return;
      failure.hidden = true;

      triedSubmit = true;
      const invalid: HTMLInputElement[] = [];
      if (!checkRequired(name)) invalid.push(name);
      invalid.push(...checkReach());
      if (!checkRequired(consent)) invalid.push(consent);
      if (invalid.length) {
        invalid[0].focus();
        return;
      }

      sending = true;
      button.disabled = true;
      button.textContent = 'Sending…';

      const data = new FormData(form);
      const provider = form.dataset.provider;
      try {
        const res =
          provider === 'netlify'
            ? await fetch(form.dataset.endpoint || '/', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams(data as unknown as Record<string, string>).toString(),
              })
            : await fetch(form.dataset.endpoint!, {
                method: 'POST',
                headers: { Accept: 'application/json' },
                body: data,
              });
        if (!res.ok) throw new Error('not ok');
        form.hidden = true;
        thanks.hidden = false;
        thanks.focus();
      } catch {
        failure.hidden = false;
        sending = false;
        button.disabled = false;
        button.textContent = button.dataset.label || 'Send in confidence';
      }
    });
  }
</script>
