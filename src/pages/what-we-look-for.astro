---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import CtaBand from '../components/CtaBand.astro';

const criteria = [
  ['Revenue', '₹1.5 crore to ₹10 crore a year'],
  ['Profitability', 'Profitable in each of the last three years'],
  ['History', 'At least seven years in business'],
  ['Customers', 'Repeat or contracted customers, with no single customer dominating'],
  ['Team', 'A business that can run day to day without the owner'],
  ['Owner', 'Ready to step back and support a handover'],
];
---

<Base
  title="The businesses we buy | Salgotra Capital"
  description="Salgotra Capital looks for established, profitable businesses that customers return to year after year. Industry and location are open across India."
>
  <PageHead
    eyebrow="What we look for"
    title="The businesses we buy."
    intro="We look for established, profitable businesses that customers return to year after year. Industry and location are open across India."
  />

  <section class="section on-light" aria-label="Our criteria">
    <div class="container look">
      <div class="look__main reveal">
        <h2 id="criteria-title" class="eyebrow criteria-label">What we look for</h2>
        <dl class="criteria" aria-labelledby="criteria-title">
          {
            criteria.map(([term, detail]) => (
              <div class="criteria__row">
                <dt>{term}</dt>
                <dd>{detail}</dd>
              </div>
            ))
          }
        </dl>
        <p class="near">
          <span class="near__lead">Not an exact match?</span> If your business is close on most points, we would still
          like to hear from you.
        </p>
      </div>

      <div class="look__side reveal">
        <div class="side-block">
          <h2>Sectors we look at first</h2>
          <p>
            Contract business services, niche manufacturing, specialist distribution, energy services, logistics and
            healthcare services.
          </p>
        </div>
        <div class="side-block">
          <h2>What we avoid</h2>
          <p>
            Businesses that depend on a single licence, contract or customer; businesses in legal disputes that
            threaten their future; and businesses we do not understand.
          </p>
        </div>
        <div class="side-block side-block--advisors">
          <h2>For advisors</h2>
          <p>
            If you are a chartered accountant, lawyer, banker or advisor with a client who might fit, we would be glad
            to hear from you, in confidence. We keep you informed at each stage, with your client's agreement.
          </p>
        </div>
      </div>
    </div>
  </section>

  <CtaBand line="If this sounds like your business, or a client's, let's talk." />
</Base>

<style>
  /* Criteria on the left, sectors, exclusions and advisors beside them on wide screens */
  .look {
    display: grid;
    gap: 3.5rem clamp(3rem, 6vw, 5.5rem);
    align-items: start;
  }
  @media (min-width: 60rem) {
    .look {
      grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    }
  }

  .criteria-label {
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }
  .criteria {
    border-top: 1px solid var(--bronze);
  }
  .criteria__row {
    display: grid;
    grid-template-columns: minmax(8rem, 11rem) 1fr;
    gap: 0.25rem 1.75rem;
    padding-block: 1.2rem;
    border-bottom: 1px solid color-mix(in srgb, var(--umber) 22%, transparent);
  }
  .criteria dt {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.4rem;
    line-height: 1.35;
    color: var(--ink);
  }
  .criteria dd {
    color: var(--ink-soft);
  }
  @media (max-width: 35.99rem) {
    .criteria__row {
      grid-template-columns: 1fr;
    }
  }

  .near {
    margin-top: 1.75rem;
    color: var(--ink-soft);
  }
  .near__lead {
    font-style: italic;
    color: var(--ink);
  }

  .side-block + .side-block {
    margin-top: 2.25rem;
    padding-top: 2.25rem;
    border-top: 1px solid color-mix(in srgb, var(--umber) 22%, transparent);
  }
  .side-block h2 {
    font-size: clamp(1.45rem, 1.3rem + 0.5vw, 1.7rem);
    line-height: 1.2;
    color: var(--ink);
    margin-bottom: 0.6rem;
  }
  .side-block p {
    color: var(--ink-soft);
  }
  /* Advisors get the one Burgundy accent on this page: a short rule above their block */
  .side-block--advisors {
    position: relative;
  }
  .side-block--advisors::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 4.5rem;
    height: 1px;
    background: var(--burgundy);
  }
</style>
