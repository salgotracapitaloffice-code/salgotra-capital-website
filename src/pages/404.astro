---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | Salgotra Capital" description="This page could not be found." noindex>
  <section class="section bg-midnight notfound" aria-labelledby="nf-title">
    <div class="container">
      <div class="measure">
        <span class="eyebrow">Page not found</span>
        <h1 id="nf-title">This page could not be found.</h1>
        <hr class="rule" />
        <p class="lede">It may have moved, or the address may be slightly different.</p>
        <a class="button" href="/">Return to the home page</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .notfound {
    min-height: 60vh;
    display: flex;
    align-items: center;
  }
  .notfound .lede {
    color: var(--ivory-soft);
    margin-bottom: 2.25rem;
  }
</style>
