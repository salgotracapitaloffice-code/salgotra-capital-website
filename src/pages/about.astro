---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import CtaBand from '../components/CtaBand.astro';

const principles = [
  [
    'Ownership over trading.',
    'We aim to create value by owning good businesses for decades, not by buying and selling them.',
  ],
  ['Survival comes first.', 'We do not take risks that could endanger a business we own.'],
  ['Our word is our asset.', 'We do what we say, in writing and on time.'],
  ['People make businesses.', 'We back the managers and teams who run them.'],
];

const team = [
  {
    name: 'Harman Salgotra',
    role: 'Founder & Managing Director',
    text: 'Acquisitions, owner and advisor relationships.',
  },
  {
    name: 'Deepanshu Singh',
    role: 'Co-Founder & Director',
    text: 'Research, administration and compliance.',
  },
];
---

<Base
  title="Built to last | About Salgotra Capital"
  description="Salgotra Capital is a new holding company based in Jammu & Kashmir, buying its first businesses now, anywhere in India, to own them permanently."
>
  <PageHead
    eyebrow="About"
    title="Built to last."
    intro="Salgotra Capital is a new holding company based in Jammu & Kashmir. We are buying our first businesses now, anywhere in India, and we intend to own every business we buy permanently."
    texture="ear"
  />

  <section class="section on-light grain grain--both" aria-labelledby="think-title">
    <div class="container">
      <div class="reveal section-head">
        <span class="eyebrow">Our principles</span>
        <h2 id="think-title">How we think</h2>
      </div>
      <ol class="think" role="list">
        {
          principles.map(([t, d], i) => (
            <li class="think__item reveal">
              <span class="think__num" aria-hidden="true">
                {['I', 'II', 'III', 'IV'][i]}
              </span>
              <h3>{t}</h3>
              <p>{d}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section bg-midnight hairline-top" aria-labelledby="team-title">
    <div class="container">
      <div class="reveal section-head">
        <h2 id="team-title">Team</h2>
      </div>
      <ul class="team" role="list">
        {
          team.map((p) => (
            <li class="team__person reveal">
              <h3>{p.name}</h3>
              <p class="team__role">{p.role}</p>
              <p class="team__text">{p.text}</p>
            </li>
          ))
        }
      </ul>
      <p class="team__note reveal">Both directors are involved in every acquisition decision.</p>
    </div>
  </section>

  <section class="section on-light" aria-labelledby="check-title">
    <div class="container">
      <div class="measure center reveal stack">
        <h2 id="check-title">How we check every purchase</h2>
        <p>
          We do not complete a purchase until independent chartered accountants and lawyers have checked it. Where
          the industry is unfamiliar to us, we also ask an experienced operator from that industry to review it.
        </p>
      </div>
    </div>
  </section>

  <section class="section bg-moss" aria-labelledby="ahead-title">
    <div class="container">
      <div class="measure center ahead reveal">
        <h2 id="ahead-title">Looking further ahead</h2>
        <hr class="rule rule--burgundy center" />
        <p class="ahead__lead">
          As the group grows, we plan to use part of its surplus to back early-stage Indian founders, with patient
          capital and the practical help of established businesses.
        </p>
        <p class="ahead__note">
          This money only comes from what is left after every business we own has what it needs to run and grow.
        </p>
      </div>
    </div>
  </section>

  <CtaBand line="If you would like to know more about us, we would be glad to talk." />
</Base>

<style>
  .section-head {
    text-align: center;
  }

  /* ---------- How we think ---------- */
  .think {
    list-style: none;
    padding: 0;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    gap: 0 clamp(2rem, 5vw, 4.5rem);
  }
  .think__item {
    padding: 1.6rem 0 2rem;
    border-top: 1px solid color-mix(in srgb, var(--umber) 30%, transparent);
    background: var(--cream);
    box-shadow: 0 0 2rem 1rem var(--cream);
  }
  .think__num {
    display: block;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    font-size: 1.15rem;
    color: var(--bronze);
    margin-bottom: 0.35rem;
  }
  .think h3 {
    color: var(--ink);
    margin-bottom: 0.5rem;
  }
  .think p {
    color: var(--ink-soft);
  }

  /* ---------- Team ---------- */
  .team {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 2.5rem clamp(2rem, 6vw, 5rem);
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  .team__person {
    border-top: 1px solid color-mix(in srgb, var(--champagne) 35%, transparent);
    padding-top: 1.5rem;
    text-align: center;
  }
  .team__person h3 {
    font-size: clamp(1.7rem, 1.5rem + 0.7vw, 2.1rem);
  }
  .team__role {
    font-style: italic;
    color: var(--champagne);
    margin: 0.3rem 0 0.6rem;
  }
  .team__text {
    color: var(--ivory);
  }
  .team__note {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    text-align: center;
    font-size: 1.15em;
  }

  /* ---------- Looking further ahead ---------- */
  .ahead {
    text-align: center;
  }
  .ahead .rule {
    margin-block: 1.5rem 1.75rem;
  }
  .ahead__lead {
    font-family: var(--font-display);
    font-weight: 600;
    font-style: italic;
    font-size: clamp(1.5rem, 1.25rem + 1vw, 2rem);
    line-height: 1.35;
    color: var(--ivory);
    text-wrap: balance;
  }
  .ahead__note {
    margin-top: 1.25rem;
    color: var(--ivory);
    font-size: 1.1em;
  }
</style>
