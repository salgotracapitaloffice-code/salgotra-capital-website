---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';

const principles = [
  ['Ownership beats trading.', 'We create value by owning good businesses for decades.'],
  ['Survival comes first.', 'We never take a risk that could harm a business we own.'],
  ['Our word is our asset.', 'We do what we say, in writing and on time.'],
  ['People make businesses.', 'We back the managers and teams who run them.'],
];

const team = [
  {
    name: 'Harman Salgotra',
    role: 'Founder & Managing Director',
    text: "Leads Salgotra Capital's strategy, acquisitions and relationships with owners and partners.",
  },
  {
    name: 'Deepanshu Singh',
    role: 'Co-Founder & Director',
    text: 'Works alongside Harman across deal research, decisions and administration.',
  },
];
---

<Base
  title="Built to last | About Salgotra Capital"
  description="Salgotra Capital is a holding company based in Jammu & Kashmir. We buy established businesses across India and own them permanently."
>
  <PageHead
    eyebrow="About"
    title="Built to last."
    intro="Salgotra Capital is a holding company based in Jammu & Kashmir. We buy established businesses across India and own them permanently. As the group grows, the businesses we own will help us back early-stage founders with patient capital and practical support."
    texture="ear"
  />

  <section class="section on-light grain" aria-labelledby="think-title">
    <div class="container">
      <div class="reveal">
        <span class="eyebrow">Our principles</span>
        <h2 id="think-title">How we think</h2>
      </div>
      <ol class="think" role="list">
        {
          principles.map(([t, d], i) => (
            <li class="think__item reveal">
              <span class="think__num" aria-hidden="true">
                {['I', 'II', 'III', 'IV'][i]}
              </span>
              <h3>{t}</h3>
              <p>{d}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section bg-midnight hairline-top" aria-labelledby="team-title">
    <div class="container">
      <div class="reveal">
        <h2 id="team-title" class="eyebrow team-label">Team</h2>
      </div>
      <ul class="team" role="list">
        {
          team.map((p) => (
            <li class="team__person reveal">
              <h3>{p.name}</h3>
              <p class="team__role">{p.role}</p>
              <p>{p.text}</p>
            </li>
          ))
        }
      </ul>
      <div class="review measure reveal">
        <hr class="rule rule--burgundy" />
        <p>
          Every acquisition is reviewed by experienced chartered accountants and corporate lawyers, with an operator
          from the industry.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .think {
    list-style: none;
    padding: 0;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 0 clamp(2rem, 5vw, 4.5rem);
    max-width: 56rem;
  }
  .think__item {
    padding: 1.6rem 0 2rem;
    border-top: 1px solid color-mix(in srgb, var(--umber) 30%, transparent);
    background: var(--cream);
    box-shadow: 0 0 2rem 1rem var(--cream);
  }
  .think__num {
    display: block;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    font-size: 1.15rem;
    color: var(--bronze);
    margin-bottom: 0.35rem;
  }
  .think h3 {
    color: var(--ink);
    margin-bottom: 0.5rem;
  }
  .think p {
    color: var(--ink-soft);
  }

  .team-label {
    font-size: 1rem;
    line-height: 1.6;
  }
  .team {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 2.5rem clamp(2rem, 6vw, 5rem);
    margin-top: 0.75rem;
  }
  .team__person {
    border-top: 1px solid color-mix(in srgb, var(--champagne) 35%, transparent);
    padding-top: 1.5rem;
  }
  .team__person h3 {
    font-size: clamp(1.7rem, 1.5rem + 0.7vw, 2.1rem);
  }
  .team__role {
    font-style: italic;
    color: var(--champagne);
    margin: 0.3rem 0 0.9rem;
  }
  .team__person p:last-child {
    color: var(--ivory-soft);
    max-width: 30rem;
  }
  .review {
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }
  .review .rule {
    margin-top: 0;
  }
  .review p {
    font-size: 1.15em;
  }
</style>
