---
const links = [
  { href: '/', label: 'Home' },
  { href: '/for-business-owners/', label: 'For business owners' },
  { href: '/what-we-look-for/', label: 'What we look for' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__logo" href="/" aria-label="Salgotra Capital, home">
      <picture>
        <source srcset="/images/logo-ivory-520.webp" type="image/webp" />
        <img src="/images/logo-ivory-520.png" alt="Salgotra Capital" width="520" height="95" />
      </picture>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="menu-toggle__label">Menu</span>
      <span class="menu-toggle__lines" aria-hidden="true"></span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="button site-nav__cta" href="/contact/">
        <span class="cta-long">Start a confidential conversation</span>
        <span class="cta-short">Start a conversation</span>
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 40;
    background: var(--midnight);
    border-bottom: 1px solid color-mix(in srgb, var(--champagne) 22%, transparent);
  }
  .site-header__inner {
    width: min(100% - 2 * var(--gutter), 80rem);
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    min-height: 5.25rem;
  }
  .site-header__logo {
    display: block;
    flex-shrink: 0;
    padding-block: 0.5rem;
  }
  .site-header__logo img {
    /* capped by screen width so large phone text never pushes the menu button off-screen */
    width: min(clamp(10rem, 7rem + 5vw, 12.5rem), 46vw);
    height: auto;
  }

  /* ---------- Desktop: five links and one button ---------- */
  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .site-nav ul {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    padding: 0;
  }
  .site-nav ul a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--ivory);
    font-size: 1.0625rem;
    white-space: nowrap;
    text-decoration-color: transparent;
    text-underline-offset: 0.35em;
  }
  .site-nav ul a:hover {
    color: var(--ivory);
    text-decoration-color: var(--champagne);
  }
  .site-nav ul a[aria-current='page'] {
    text-decoration-color: var(--champagne);
  }
  .site-nav__cta {
    white-space: nowrap;
    padding-inline: 1.2rem;
  }
  .cta-short {
    display: none;
  }
  /* Between 1024 and 1200px there is only room for the shorter wording */
  @media (min-width: 64rem) and (max-width: 74.99rem) {
    .cta-long {
      display: none;
    }
    .cta-short {
      display: inline;
    }
    .site-nav ul {
      gap: 1rem;
    }
    .site-nav ul a {
      font-size: 1rem;
    }
  }

  /* ---------- Menu toggle (below 1024px) ---------- */
  .menu-toggle {
    display: none;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    min-width: 2.75rem;
    padding: 0.5rem 0.25rem 0.5rem 0.75rem;
    background: none;
    border: 0;
    color: var(--ivory);
    font-size: 1.0625rem;
    letter-spacing: 0.06em;
    cursor: pointer;
  }
  .menu-toggle:hover {
    color: var(--champagne);
  }
  .menu-toggle__lines,
  .menu-toggle__lines::before {
    display: block;
    width: 1.4rem;
    height: 1px;
    background: currentColor;
    transition: transform var(--fast) var(--ease);
  }
  .menu-toggle__lines {
    position: relative;
    transform: translateY(-3px);
  }
  .menu-toggle__lines::before {
    content: '';
    position: absolute;
    top: 6px;
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle__lines {
    transform: translateY(0) rotate(45deg);
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle__lines::before {
    transform: translateY(-6px) rotate(-90deg);
  }

  /* ---------- Mobile and tablet: full-height panel ---------- */
  @media (max-width: 63.99rem) {
    .menu-toggle {
      display: inline-flex;
      position: relative;
      z-index: 2;
    }
    .site-nav {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 1;
      flex-direction: column;
      align-items: stretch;
      gap: 2rem;
      padding: calc(5.25rem + 1.5rem) var(--gutter) 2.5rem;
      background: var(--midnight);
      overflow-y: auto;
      overscroll-behavior: contain;
    }
    .site-nav.is-open {
      display: flex;
    }
    .site-header__logo {
      position: relative;
      z-index: 2;
    }
    .site-nav ul {
      flex-direction: column;
      gap: 0;
      border-top: 1px solid color-mix(in srgb, var(--champagne) 30%, transparent);
    }
    .site-nav ul li {
      border-bottom: 1px solid color-mix(in srgb, var(--ivory) 12%, transparent);
    }
    .site-nav ul a {
      display: flex;
      min-height: 3.5rem;
      font-size: 1.5rem;
      font-family: var(--font-display);
      font-weight: 600;
      white-space: normal;
    }
    .site-nav__cta {
      white-space: normal;
    }
  }
  /* Without JavaScript, show the links in a simple wrapped row */
  :global(html:not(.js)) .menu-toggle {
    display: none;
  }
  @media (max-width: 63.99rem) {
    :global(html:not(.js)) .site-nav {
      display: flex;
      position: static;
      padding: 0 0 1.5rem;
    }
    :global(html:not(.js)) .site-header__inner {
      flex-wrap: wrap;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.getElementById('site-nav');
  if (toggle && nav) {
    const label = toggle.querySelector('.menu-toggle__label');
    // Everything outside the header is made inert while the menu is open
    const outside = () => document.querySelectorAll<HTMLElement>('body > :not(.site-header)');

    const set = (open: boolean, returnFocus = false) => {
      toggle.setAttribute('aria-expanded', String(open));
      nav.classList.toggle('is-open', open);
      document.documentElement.classList.toggle('menu-open', open);
      outside().forEach((el) => (el.inert = open));
      if (label) label.textContent = open ? 'Close' : 'Menu';
      if (open) nav.querySelector<HTMLAnchorElement>('a')?.focus();
      else if (returnFocus) toggle.focus();
    };

    toggle.addEventListener('click', () => set(toggle.getAttribute('aria-expanded') !== 'true', true));
    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a') && nav.classList.contains('is-open')) set(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.classList.contains('is-open')) set(false, true);
    });
    window.matchMedia('(min-width: 64rem)').addEventListener('change', (e) => e.matches && set(false));
  }
</script>
