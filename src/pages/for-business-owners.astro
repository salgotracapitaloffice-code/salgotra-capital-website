---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';

const steps = [
  {
    title: 'A first conversation.',
    text: 'We listen to your story and what matters to you. No numbers, no commitment.',
  },
  {
    title: 'Getting to know the business.',
    text: 'After a confidentiality agreement, we look at a short list of information, often supplied by your CA.',
  },
  {
    title: 'A written offer.',
    text: 'We set out the price and how it will be paid, in plain language.',
  },
  {
    title: 'Careful checks.',
    text: 'Our chartered accountants and lawyers confirm the details with you and your advisors.',
  },
  {
    title: 'Completion and handover.',
    text: 'You stay involved for an agreed period, introducing us to your team and customers, so the business continues smoothly.',
  },
];

const promises = [
  'We tell you the truth, including when something does not fit.',
  'We do not waste your time: if we cannot make an offer, we say so early.',
  'We respect your people, your customers and your name.',
  'We keep everything you share strictly confidential.',
];

const questions = [
  {
    q: 'Do I have to sell everything at once?',
    a: 'No. Some owners keep a share and stay involved. We discuss what suits you.',
  },
  {
    q: 'Will my staff keep their jobs?',
    a: 'Our intention is to keep the team. The people who built the business are why it works.',
  },
  {
    q: 'How long does it take?',
    a: 'Usually several months from first conversation to completion, depending on the business.',
  },
  {
    q: 'Who will run the business after I step back?',
    a: "An experienced manager, chosen with your input, who has a stake in the business's success.",
  },
];
---

<Base
  title="A careful way to step back | Salgotra Capital"
  description="Selling a business you built is one of the biggest decisions of your life. Salgotra Capital makes the process clear, unhurried and private."
>
  <PageHead
    eyebrow="For business owners"
    title="A careful way to step back."
    intro="Selling a business you built is one of the biggest decisions of your life. We make the process clear, unhurried and private."
  />

  <section class="section on-light grain" aria-labelledby="how-title">
    <div class="container">
      <div class="reveal">
        <span class="eyebrow">The process</span>
        <h2 id="how-title">How it works</h2>
      </div>
      <ol class="timeline" role="list">
        {
          steps.map((s, i) => (
            <li class="timeline__step reveal">
              <span class="timeline__num" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div class="timeline__body">
                <h3>
                  <span class="visually-hidden">Step {i + 1}: </span>
                  {s.title}
                </h3>
                <p>{s.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section bg-moss" aria-labelledby="promise-title">
    <div class="container">
      <div class="promise reveal">
        <div>
          <h2 id="promise-title">What we promise</h2>
        </div>
        <ul class="promise__list" role="list">
          {promises.map((p) => <li>{p}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section on-light" aria-labelledby="faq-title">
    <div class="container">
      <div class="measure center">
        <div class="reveal">
          <h2 id="faq-title">Questions owners ask</h2>
        </div>
        <div class="faq reveal">
          {
            questions.map((item) => (
              <details class="faq__item">
                <summary>
                  <span>{item.q}</span>
                  <span class="faq__mark" aria-hidden="true" />
                </summary>
                <p>{item.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-midnight cta-band" aria-labelledby="cta-title">
    <div class="container reveal">
      <h2 id="cta-title" class="visually-hidden">Start a confidential conversation</h2>
      <a class="button" href="/contact/">Start a confidential conversation</a>
    </div>
  </section>
</Base>

<style>
  /* ---------- Timeline ---------- */
  .timeline {
    list-style: none;
    padding: 0;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    max-width: 46rem;
    position: relative;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 1.6rem;
    top: 0.75rem;
    bottom: 2.5rem;
    width: 1px;
    background: color-mix(in srgb, var(--umber) 35%, transparent);
  }
  .timeline__step {
    position: relative;
    display: grid;
    grid-template-columns: 3.2rem 1fr;
    gap: 0 clamp(1.25rem, 3vw, 2.25rem);
    padding-bottom: clamp(2rem, 4vw, 2.75rem);
  }
  .timeline__step:last-child {
    padding-bottom: 0;
  }
  .timeline__num {
    position: relative;
    display: grid;
    place-items: center;
    width: 3.2rem;
    height: 3.2rem;
    border: 1px solid var(--bronze);
    border-radius: 50%;
    background: var(--cream);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    color: var(--bronze);
    font-variant-numeric: lining-nums;
  }
  .timeline__body {
    padding-top: 0.55rem;
    background: var(--cream);
    box-shadow: 0 0 2rem 1rem var(--cream);
  }
  .timeline h3 {
    color: var(--ink);
    margin-bottom: 0.4rem;
  }
  .timeline p {
    color: var(--ink-soft);
  }

  /* ---------- Promise ---------- */
  .promise {
    display: grid;
    gap: 2rem clamp(2rem, 6vw, 5rem);
  }
  @media (min-width: 56rem) {
    .promise {
      grid-template-columns: 1fr 1.6fr;
    }
  }
  .promise__list {
    list-style: none;
    padding: 0;
  }
  .promise__list li {
    padding: 1.15rem 0 1.15rem 2rem;
    position: relative;
    border-top: 1px solid color-mix(in srgb, var(--champagne) 28%, transparent);
    font-size: 1.15em;
    line-height: 1.5;
  }
  .promise__list li:last-child {
    border-bottom: 1px solid color-mix(in srgb, var(--champagne) 28%, transparent);
  }
  .promise__list li::before {
    content: '';
    position: absolute;
    left: 0.15rem;
    top: 1.95rem;
    width: 0.9rem;
    height: 1px;
    background: var(--champagne);
  }

  /* ---------- Accordion ---------- */
  .faq {
    margin-top: 2.5rem;
    border-top: 1px solid color-mix(in srgb, var(--umber) 30%, transparent);
  }
  .faq__item {
    border-bottom: 1px solid color-mix(in srgb, var(--umber) 30%, transparent);
  }
  .faq__item summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    min-height: 3.5rem;
    padding: 1.1rem 0;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.3rem, 1.2rem + 0.4vw, 1.5rem);
    line-height: 1.25;
    color: var(--ink);
    transition: color var(--fast) var(--ease);
  }
  .faq__item summary::-webkit-details-marker {
    display: none;
  }
  .faq__item summary:hover {
    color: var(--burgundy);
  }
  .faq__mark {
    position: relative;
    flex: none;
    width: 1rem;
    height: 1rem;
  }
  .faq__mark::before,
  .faq__mark::after {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 1rem;
    height: 1px;
    background: currentColor;
    transition: transform var(--fast) var(--ease);
  }
  .faq__mark::after {
    transform: rotate(90deg);
  }
  .faq__item[open] .faq__mark::after {
    transform: rotate(0deg);
  }
  .faq__item p {
    padding: 0 2.5rem 1.5rem 0;
    color: var(--ink-soft);
  }
</style>
