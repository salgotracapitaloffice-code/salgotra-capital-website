---
import '@fontsource/cormorant-garamond/latin-600.css';
import '@fontsource/cormorant-garamond/latin-600-italic.css';
import '@fontsource/eb-garamond/latin-400.css';
import '@fontsource/eb-garamond/latin-400-italic.css';
import '@fontsource/eb-garamond/latin-500.css';
import '../styles/global.css';
import displayFont from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-600-normal.woff2?url';
import bodyFont from '@fontsource/eb-garamond/files/eb-garamond-latin-400-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../site.config.mjs';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  heroPreload?: boolean;
}
const { title, description, noindex = false, heroPreload = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.domain).href;
const ogImage = new URL('/images/og-image.jpg', SITE.domain).href;
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, interactive-widget=resizes-content" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#19212c" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    {
      heroPreload && (
        <>
          <link
            rel="preload"
            as="image"
            type="image/avif"
            media="(min-width: 48rem)"
            imagesrcset="/images/hero-960.avif 960w, /images/hero-1440.avif 1440w, /images/hero-1920.avif 1920w"
            imagesizes="100vw"
            fetchpriority="high"
          />
          <link
            rel="preload"
            as="image"
            type="image/avif"
            media="(max-width: 47.99rem)"
            imagesrcset="/images/hero-mobile-480.avif 480w, /images/hero-mobile-720.avif 720w, /images/hero-mobile-900.avif 900w"
            imagesizes="100vw"
            fetchpriority="high"
          />
        </>
      )
    }

    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Salgotra Capital wordmark beside a softly lit elephant" />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <script>
      // Sections fade up gently, once, as they enter view.
      const items = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window && items.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
